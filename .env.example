POPPY_PUBLIC_BASE_URL=https://poppy.example

POPPY_MODEL=gpt-5.6-luna
POPPY_REVIEW_LANGUAGE=Italian
POPPY_REVIEW_TONE=concise and direct
POPPY_BLOCKING_SEVERITY=high
POPPY_CONTEXT_LIMIT_CHARACTERS=160000
POPPY_REVIEW_TIMEOUT_SECONDS=300
POPPY_CONCURRENCY=3

POPPY_HOST_PORT=8000
POPPY_LOG_LEVEL=info
